rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn() && request.auth.uid == 'kXOgLCRPC0VhkqQltsgO1feNPLO2';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.active == true
        && userDoc().data.role in roles;
    }

    function canRead() {
      return isBootstrapAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.active == true
        );
    }

    function canCreateWork() {
      return canRead();
    }

    function canAdmin() {
      return isBootstrapAdmin() || hasRole(['admin']);
    }

    function canManageOrders() {
      return canAdmin() || hasRole(['supervisor']);
    }

    function canSupervisorUpdateOrder() {
      return hasRole(['supervisor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paid',
          'status',
          'returnedAt',
          'inspectedAt',
          'returnNotes',
          'returnedBy',
          'returnedByName',
          'receivedBy',
          'replacementPending',
          'amountPaid',
          'items',
          'clientId',
          'clientName',
          'clientPhone',
          'updatedBy',
          'updatedByName',
          'updatedAt',
          'cancelledBy',
          'cancelledByName'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canAdmin());
      allow create: if canAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'staff'
          && request.resource.data.active == true
        );
      allow update: if canAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.role == request.resource.data.role
          && resource.data.active == request.resource.data.active
        );
      allow delete: if canAdmin();
    }

    match /clients/{clientId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update: if canManageOrders();
      allow delete: if canAdmin();
    }

    match /inventoryItems/{itemId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update: if canAdmin();
      allow delete: if canAdmin();
    }

    match /orders/{orderId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update: if canAdmin() || canSupervisorUpdateOrder();
      allow delete: if canAdmin();
    }

    match /orders/{orderId}/attachments/{attachmentId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update, delete: if canManageOrders();
    }

    match /incidents/{incidentId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update, delete: if canAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read: if canRead();
      allow create: if canCreateWork();
      allow update, delete: if canAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if canAdmin();
      allow create: if canCreateWork();
      allow update, delete: if canAdmin();
    }

    match /settings/{settingId} {
      allow read: if canRead();
      allow write: if canAdmin();
    }


    // Hallowow Karaoke: sala publica limitada a comandos de reproduccion.
    // GitHub Pages aloja la interfaz; Firestore solo sincroniza selector <-> player.
    function validKaraokeRoomId(roomId) {
      return roomId.size() >= 4 && roomId.size() <= 32;
    }

    function validKaraokeState() {
      return request.resource.data.keys().hasOnly([
          'songId',
          'versionId',
          'command',
          'nonce',
          'startAt',
          'endAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'songId',
          'versionId',
          'command',
          'nonce',
          'startAt',
          'endAt',
          'updatedAt'
        ])
        && request.resource.data.songId == 'carinito'
        && request.resource.data.versionId in ['chorus', 'full']
        && request.resource.data.command in ['load', 'play', 'pause', 'restart', 'stop']
        && request.resource.data.nonce is int
        && request.resource.data.startAt is number
        && request.resource.data.endAt is number
        && request.resource.data.startAt >= 0
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.endAt <= 240
        && request.resource.data.updatedAt == request.time;
    }

    match /karaokeRooms/{roomId} {
      allow read: if validKaraokeRoomId(roomId);
      allow create, update: if validKaraokeRoomId(roomId) && validKaraokeState();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
