{
  "songId": "y-se-llama-peru",
  "title": "Y se llama Perú",
  "status": "estimated",
  "reviewRequired": true,
  "timingMethod": "text-length-proportional; not aligned to vocals or instrumental sections",
  "durationSeconds": 185.365,
  "lyrics": [
    {
      "text": "Cosechando mis mares, sembrando mis tierras",
      "start": 0.0,
      "end": 7.250005
    },
    {
      "text": "Quiero más a mi patria",
      "start": 7.250005,
      "end": 10.777035
    },
    {
      "text": "Mi nación que luchando",
      "start": 10.777035,
      "end": 14.500011
    },
    {
      "text": "Rompió las cadenas de la esclavitud",
      "start": 14.500011,
      "end": 20.378393
    },
    {
      "text": "Es la tierra del inca",
      "start": 20.378393,
      "end": 23.709477
    },
    {
      "text": "Que el Sol ilumina porque Dios lo manda",
      "start": 23.709477,
      "end": 29.979752
    },
    {
      "text": "Y es que Dios a la gloria le cambió de nombre",
      "start": 29.979752,
      "end": 36.837865
    },
    {
      "text": "Y le puso Perú",
      "start": 36.837865,
      "end": 38.993272
    },
    {
      "text": "Atesoran sus playas",
      "start": 38.993272,
      "end": 42.324355
    },
    {
      "text": "La riqueza pesquera de mi mar soberano",
      "start": 42.324355,
      "end": 48.59463
    },
    {
      "text": "Y en la sierra bravía",
      "start": 48.59463,
      "end": 51.925714
    },
    {
      "text": "La nieve perpetua, bandera de paz",
      "start": 51.925714,
      "end": 57.216258
    },
    {
      "text": "La montaña en sus venas",
      "start": 57.216258,
      "end": 60.939234
    },
    {
      "text": "Guardado el petróleo de nuestro mañana",
      "start": 60.939234,
      "end": 67.405455
    },
    {
      "text": "Y la tierra serrana",
      "start": 67.405455,
      "end": 70.540592
    },
    {
      "text": "Nos da a manos llenas, el acero y el pan",
      "start": 70.540592,
      "end": 76.418975
    },
    {
      "text": "Y se llama Perú",
      "start": 76.418975,
      "end": 78.770328
    },
    {
      "text": "Con P de patria",
      "start": 78.770328,
      "end": 81.121681
    },
    {
      "text": "La E del ejemplo",
      "start": 81.121681,
      "end": 83.66898
    },
    {
      "text": "La R del rifle",
      "start": 83.66898,
      "end": 85.824387
    },
    {
      "text": "La U de la unión",
      "start": 85.824387,
      "end": 88.17574
    },
    {
      "text": "Yo me llamo Perú",
      "start": 88.17574,
      "end": 90.723039
    },
    {
      "text": "Pues mi raza peruana",
      "start": 90.723039,
      "end": 94.054123
    },
    {
      "text": "Con la sangre y el alma",
      "start": 94.054123,
      "end": 97.581152
    },
    {
      "text": "Pintó los colores de mi pabellón",
      "start": 97.581152,
      "end": 102.871697
    },
    {
      "text": "Yo también me llamo Perú",
      "start": 102.871697,
      "end": 106.790618
