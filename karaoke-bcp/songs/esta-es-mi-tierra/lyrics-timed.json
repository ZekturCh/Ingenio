    {
      "text": "Esta es mi tierra",
      "start": 0.0,
      "end": 3.664757
    },
    {
      "text": "Así es mi Perú",
      "start": 3.664757,
      "end": 6.54421
    },
    {
      "text": "Esta es mi tierra",
      "start": 6.54421,
      "end": 10.208967
    },
    {
      "text": "Así es mi Perú",
      "start": 10.208967,
      "end": 13.088419
    },
    {
      "text": "Raza que al mundo escribiera",
      "start": 13.088419,
      "end": 19.37086
    },
    {
      "text": "La historia viril del Imperio del Sol",
      "start": 19.37086,
      "end": 27.48568
    },
    {
      "text": "Enarbolada flamea mi bandera bicolor",
      "start": 27.48568,
      "end": 35.862268
    },
    {
      "text": "En costa, montaña y sierra",
      "start": 35.862268,
      "end": 41.359404
    },
    {
      "text": "Con paz, trabajo y amor",
      "start": 41.359404,
      "end": 46.071235
    },
    {
      "text": "La riqueza de su costa",
      "start": 46.071235,
      "end": 50.783066
    },
    {
      "text": "En el mundo sin igual",
      "start": 50.783066,
      "end": 55.233129
    },
    {
      "text": "Y la sierra generosa",
      "start": 55.233129,
      "end": 59.683191
    },
    {
      "text": "Fructifica nuestro pan",
      "start": 59.683191,
      "end": 64.918559
    },
    {
      "text": "Mientras la montaña espera",
      "start": 64.918559,
      "end": 70.939232
    },
    {
      "text": "Quien la vaya a conquistar",
      "start": 70.939232,
      "end": 76.698136
    },
    {
      "text": "El orgullo de mi raza",
      "start": 76.698136,
      "end": 81.148199
    },
    {
      "text": "Es la historia del Perú",
      "start": 81.148199,
      "end": 86.121798
    },
    {
      "text": "Y quiero que este tondero",
      "start": 86.121798,
      "end": 91.618934
    },
    {
      "text": "Con sabor a gratitud",
      "start": 91.618934,
      "end": 96.068996
    },
    {
      "text": "Se escuche en los cuatro vientos",
      "start": 96.068996,
      "end": 103.136743
    },
    {
      "text": "En el norte, centro y sur",
      "start": 103.136743,
      "end": 108.110342
    },
    {
      "text": "¿Cómo dice?",
      "start": 108.110342,
      "end": 110.204489
    },
