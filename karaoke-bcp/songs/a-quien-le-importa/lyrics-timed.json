  "lyrics": [
    {
      "text": "La gente me señala",
      "start": 0.0,
      "end": 3.385433
    },
    {
      "text": "Me apuntan con el dedo",
      "start": 3.385433,
      "end": 7.447954
    },
    {
      "text": "Susurra a mis espaldas",
      "start": 7.447954,
      "end": 11.736169
    },
    {
      "text": "Y a mí me importa un bledo",
      "start": 11.736169,
      "end": 16.250081
    },
    {
      "text": "¿Qué más me da",
      "start": 16.250081,
      "end": 18.507036
    },
    {
      "text": "Si soy distinta a ellos?",
      "start": 18.507036,
      "end": 22.795252
    },
    {
      "text": "No soy de nadie",
      "start": 22.795252,
      "end": 25.503599
    },
    {
      "text": "No tengo dueño",
      "start": 25.503599,
      "end": 28.211945
    },
    {
      "text": "Yo sé que me critican",
      "start": 28.211945,
      "end": 32.04877
    },
    {
      "text": "Me consta que me odian",
      "start": 32.04877,
      "end": 36.11129
    },
    {
      "text": "La envidia les corroe",
      "start": 36.11129,
      "end": 40.17381
    },
    {
      "text": "Mi vida les agobia",
      "start": 40.17381,
      "end": 43.559244
    },
    {
      "text": "¿Por qué será?",
      "start": 43.559244,
      "end": 45.816199
    },
    {
      "text": "Yo no tengo la culpa",
      "start": 45.816199,
      "end": 49.427328
    },
    {
      "text": "Mi circunstancia les insulta",
      "start": 49.427328,
      "end": 55.069717
    },
    {
      "text": "Mi destino es el que yo decido",
      "start": 55.069717,
      "end": 60.486411
    },
    {
      "text": "El que yo elijo para mí",
      "start": 60.486411,
      "end": 64.548931
    },
    {
      "text": "¿A quién le importa lo que yo haga?",
      "start": 64.548931,
      "end": 70.417016
    },
    {
      "text": "¿A quién le importa lo que yo diga?",
      "start": 70.417016,
      "end": 76.2851
    },
    {
      "text": "Yo soy así y así seguiré",
      "start": 76.2851,
      "end": 80.573316
    },
    {
      "text": "Nunca cambiaré",
      "start": 80.573316,
      "end": 83.507358
    },
    {
      "text": "¿A quién le importa lo que yo haga?",
      "start": 83.507358,
      "end": 89.375443
