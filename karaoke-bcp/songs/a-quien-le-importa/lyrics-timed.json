    {
      "text": "Por no seguir la norma",
      "start": 106.30261,
      "end": 110.36513
    },
    {
      "text": "Ya es demasiado tarde",
      "start": 110.36513,
      "end": 114.42765
    },
    {
      "text": "Para cambiar ahora",
      "start": 114.42765,
      "end": 118.038779
    },
    {
      "text": "Me mantendré",
      "start": 118.038779,
      "end": 120.521431
    },
    {
      "text": "Firme en mis convicciones",
